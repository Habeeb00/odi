DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Signs the login/admin session cookie. Falls back to an insecure dev default
# if unset — always set a real random value in production.
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: powers the "✨ AI" laughing/crying photo generator in Admin.
# Get a key at https://aistudio.google.com/apikey — without it, admins can
# still upload all three photos by hand.
GEMINI_API_KEY=""
