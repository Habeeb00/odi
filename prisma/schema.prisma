// Oddy Board data model — kept intentionally small (see PRD section 29).
// Leaderboard scores are derived by summing OD.finalScore per accused member;
// no separate Score table is maintained to avoid a second source of truth.
// SQLite has no native enum support, so status/vote/severity are validated
// strings (allowed values documented alongside each field).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  // Short invite code the creator shares with others so only people who
  // have it can join the room. Independent from `slug` (which is used for
  // the URL) so the two can be rotated/rethought separately later.
  // Nullable so existing boards created before this field don't break
  // migration; new boards always get one, older ones can generate one
  // from the admin settings.
  joinCode            String?  @unique
  // Separate secret gating /admin — a member's join code lets them raise and
  // vote, nothing more; only whoever holds this code can manage members,
  // categories, assets, and settings. Nullable for the same reason as
  // joinCode: it's backfilled below for boards created before this field.
  adminCode           String?  @unique
  createdBy           String
  // The Member standing in for `createdBy` — set at creation so the admin
  // is always a board member too, not just a name. Plain id, not a Prisma
  // relation, so deleting that Member doesn't need special-casing here.
  // Null for boards created before this existed.
  creatorMemberId     String?
  votingDurationHours Int      @default(24)
  dailyOdLimit        Int      @default(3)
  createdAt           DateTime @default(now())

  members    Member[]
  categories Category[]
  ods        OD[]
}

model Member {
  id         String  @id @default(cuid())
  boardId    String
  name       String
  image      String?
  // Extra sticker-style photos shown on the display's race bar depending on
  // standing: imageHappy for the current leader, imageSad for last place.
  // Both fall back to `image` when not uploaded.
  imageHappy String?
  imageSad   String?
  // Set the first time this member claims their name (join code + choose a
  // password); null means the name is still unclaimed and up for grabs by
  // anyone who knows the board's join code. Once set, logging back in as
  // this member needs the password, not the join code.
  passwordHash String?
  board      Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  raisedOds  OD[]   @relation("RaisedBy")
  accusedOds OD[]   @relation("Accused")
  votes      Vote[]

  createdAt DateTime @default(now())
}

model Category {
  id          String @id @default(cuid())
  boardId     String
  name        String
  // JSON string, e.g. {"OD":10,"SMALL_OD":5,"REJECT":0}
  scoringRule String
  board       Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  ods    OD[]
  assets Asset[]

  createdAt DateTime @default(now())
}

model OD {
  id          String   @id @default(cuid())
  boardId     String
  raisedById  String
  accusedId   String
  categoryId  String
  description String
  evidence    String?
  // "PENDING" | "CLOSED"
  status      String   @default("PENDING")
  finalScore  Int?
  createdAt   DateTime @default(now())
  closesAt    DateTime

  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  raisedBy Member   @relation("RaisedBy", fields: [raisedById], references: [id])
  accused  Member   @relation("Accused", fields: [accusedId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  votes    Vote[]
}

model Vote {
  id        String   @id @default(cuid())
  odId      String
  memberId  String
  // "OD" | "SMALL_OD" | "REJECT"
  vote      String
  createdAt DateTime @default(now())

  od     OD     @relation(fields: [odId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id])

  @@unique([odId, memberId])
}

model Asset {
  id         String   @id @default(cuid())
  categoryId String
  file       String?
  dialogue   String?
  // "MILD" | "MEDIUM" | "SEVERE" | null
  severity   String?
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
